# Random server-only string used to hash viewer IPs for share-view analytics.
# Daily-rotated: dailySalt = sha256(IP_HASH_BASE_SALT + YYYY-MM-DD).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_BASE_SALT=

# Enable Banking sandbox (AIS demo at /demo/open-banking).
# Generate the keypair in the EB control panel and paste the PEM-encoded
# private key here; newlines must be escaped as \n in .env.local.
EB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
EB_APP_ID="your-app-id-from-enablebanking-portal"

# TDS (Tenancy Deposit Scheme) deposit integration.
# 32-byte hex key (64 hex chars) used to encrypt each agency's TDS api_key at
# rest. Generate with: openssl rand -hex 32
# NOTE: the actual TDS credentials (Member ID, Branch ID, API Key) are NOT env
# vars — a super admin enters them per agency under /admin/deposit-schemes and
# they are stored encrypted in the tds_connections table.
TDS_TOKEN_SECRET=

# DPS (Deposit Protection Service / Computershare) deposit integration.
# 32-byte hex key (64 hex chars) used to encrypt each agency's DPS client_secret
# at rest. Generate with: openssl rand -hex 32
# NOTE: the actual DPS credentials (Client ID, Client Secret, Agent/Landlord ID)
# are NOT env vars — a super admin enters them per agency under
# /admin/deposit-schemes and they are stored encrypted in dps_connections.
# (DPS_TEST_* vars are only read by scripts/dps-uat-probe.mjs, not the app.)
DPS_TOKEN_SECRET=

# Per-agency email provider credentials (Microsoft Graph / Gmail / SMTP).
# 32-byte hex key (64 hex chars) used to encrypt each agency's email transport
# credentials at rest. Generate with: openssl rand -hex 32
# NOTE: the actual provider credentials (OAuth tokens / SMTP passwords) are NOT
# env vars — they are stored encrypted per agency in the email_providers table.
# When absent or unset, sends fall back to the central Resend mailer.
EMAIL_PROVIDER_TOKEN_SECRET=

# Microsoft 365 (Graph) email transport — delegated OAuth for the per-agency
# "Connect Microsoft 365" flow under /settings/email. Register a web app in
# Azure AD with the delegated Mail.Send scope.
# IMPORTANT: the redirect URI must be a SINGLE FIXED host, not a {slug}
# subdomain (OAuth forbids wildcards). Agencies connect from their subdomain but
# the OAuth state is stored server-side (email_provider_oauth_states) so one
# fixed callback works for all of them, then redirects back to the tenant's
# subdomain. Use the apex in prod:
#   dev:  http://localhost:3000/api/email/graph/callback
#   prod: https://harborops.co.uk/api/email/graph/callback
# MICROSOFT_REDIRECT_URI must match this exactly (and be registered in Azure).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# Optional: set to your Azure AD tenant id for a single-tenant app registration.
# Defaults to "common" (multi-tenant / any Microsoft account).
MICROSOFT_TENANT_ID=

# Gmail (Google Workspace) email transport — send-only OAuth for the per-agency
# "Connect Gmail" flow under /settings/email. Reuses GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET (also used by the leads inbox), but with a SEPARATE
# redirect URI registered on the same OAuth client and the gmail.send scope.
# Like the Microsoft one, this is a SINGLE FIXED host (not a {slug} subdomain):
#   dev:  http://localhost:3000/api/email/gmail/callback
#   prod: https://harborops.co.uk/api/email/gmail/callback
# Start Google OAuth verification early — it can take weeks to approve.
GOOGLE_SEND_REDIRECT_URI=

# Google service account for landlord listing spreadsheets (Landlords → Listings
# spreadsheet URL). Enable BOTH the Sheets API and the Drive API on the project.
#
# You usually do NOT need to set anything here: drop the downloaded key JSON at
# ./service_account.json in the project root (already gitignored) and it is
# picked up automatically. Use GOOGLE_SERVICE_ACCOUNT_FILE for a custom path, or
# the env var below when the filesystem isn't an option (base64-encode it — the
# key contains newlines that .env cannot hold unquoted).
# Either way, RESTART the server after changing it.
#
#   Sheets — OPTIONAL. Sheets shared as "Anyone with the link — Viewer" are read
#            through their CSV export endpoint with no credentials at all. Only
#            needed to read sheets kept private (share each with client_email).
#   Drive  — REQUIRED for photo import. There is no credential-free way to list
#            a Drive folder, so without this the room-photo import is skipped
#            (the listings themselves still import fine).
#
# Note: photo URLs point at Drive, so the photo folder must ALSO be shared
# "Anyone with the link" for images to render for end users — sharing it with
# only the service account lets us read it but leaves the images unviewable.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Deprecated alias, still honoured so existing deployments keep working.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# mydeposits (Total Property) auth flow selector.
#   browser  = default; authorization-code redirect via /connect/authorize.
#   headless = email/SMS "Login" (Consumer) flow via /api/v1/ui/* — fallback
#              while the browser authorize endpoint returns a blank page.
# Probe the headless flow before switching: npm run mydeposits:headless
MYDEPOSITS_AUTH_MODE=browser

# OPTIONAL — Supabase JWT secret for opt-in app-layer access-token signature
# verification (defense-in-depth on top of RLS). When set, the server verifies
# each access token's HS256 signature before trusting its `sub`/`exp`; when
# unset, the token is decoded without a signature check (RLS remains the DB
# boundary). Value = Supabase dashboard → Settings → API → JWT Secret.
# ONLY set this for projects using the legacy symmetric (HS256) JWT secret.
# Projects on Supabase's asymmetric JWT signing keys (ES256/RS256) must leave
# this UNSET, or every session will fail verification.
SUPABASE_JWT_SECRET=

# OPTIONAL — extra webhook auth. The Gmail push webhook prefers a secret sent
# via the `x-webhook-secret` (or `Authorization: Bearer`) header, falling back
# to the `?secret=` query param for Google Pub/Sub (which can't send headers).
GMAIL_WEBHOOK_SECRET=
